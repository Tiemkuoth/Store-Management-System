# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=store_management_db
DB_USER=root
DB_PASSWORD=your_secure_database_password

# Server Configuration
PORT=5000

# JWT Security (CRITICAL: Generate with: openssl rand -base64 32)
# DO NOT use the placeholder below - generate a new secret for production
JWT_SECRET=your_secure_random_jwt_secret_base64_encoded_string_here

# CORS Configuration (Specify your frontend domain, never use wildcard with credentials)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Email Configuration (Optional - leave empty to log to console instead)
# For Gmail: Use 'smtp.gmail.com' and generate App Password from https://myaccount.google.com/apppasswords
# ── EMAIL NOTIFICATION SETTINGS ──────────────────────────────────────
# Using Mailtrap / SMTP for general system emails
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_pass
EMAIL_FROM="Store System <noreply@store.local>"

# ── GOOGLE GMAIL OAUTH INTEGRATION ──────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/

# Environment (development or production)
NODE_ENV=development

# Session Configuration (Optional)
SESSION_SECRET=your_session_secret_here
SESSION_EXPIRY_HOURS=24
